# Local defaults use SQLite and local uploads.
DATABASE_URL=sqlite:///./frame.db
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=backend/uploads
MAX_VIDEO_MB=100
MAX_IMAGE_MB=10

# AWS: set both bucket names and optionally a region. Credentials come from
# the EC2 instance role or the standard AWS credential provider chain.
# AWS_REGION=us-east-1
# S3_VIDEO_BUCKET=
# S3_THUMBNAIL_BUCKET=
# S3_PUBLIC_BASE_URL=
